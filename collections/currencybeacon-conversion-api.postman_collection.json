          "name": "Convert currency amount",
          "request": {
            "name": "Convert currency amount",
            "description": {
              "content": "Converts an amount from one currency to another using mid-market exchange rates. Supports both real-time and historical date-based conversions.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "convert"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<string>",
                  "description": "(Required) Three-letter ISO 4217 code of the source currency."
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<string>",
                  "description": "(Required) Three-letter ISO 4217 code of the target currency."
                },
                {
                  "disabled": false,
                  "key": "amount",
                  "value": "<double>",
                  "description": "(Required) Numeric amount to convert."
                },
                {
                  "disabled": false,
                  "key": "date",
                  "value": "<date>",
                  "description": "Historical date in YYYY-MM-DD format for historical conversion. If omitted, the latest rate is used."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
